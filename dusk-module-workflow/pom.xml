<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dusk</groupId>
        <artifactId>dusk-module-parent</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>
    <artifactId>dusk-module-workflow</artifactId>
    <name>dusk-module-workflow</name>

    <properties>
        <flyway.table>flyway_schema_history_workflow</flyway.table>
        <flyway.url>jdbc:postgresql://dusk.com:5432/crux</flyway.url>
        <flyway.user>postgres</flyway.user>
        <flyway.password>Unitech2020</flyway.password>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-mqs</artifactId>
        </dependency>

        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-module-workflow-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-module-auth-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-rpc</artifactId>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>github-dusk-common</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-common</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <!--
                单元测试覆盖率门禁（JaCoCo）。
                - test 阶段生成 target/site/jacoco 报告
                - verify 阶段校验 BUNDLE 分支覆盖率不低于 98%
                  （实测 BRANCH 99.23%(385/388) / LINE 99.35% / INSTRUCTION 99.23% / METHOD 100% / CLASS 100%，
                   余下 3 个分支为不可达死分支：hasTaskPermission 的 assignees==null、
                   toTodoList 的 pushDto==null、convertInputStreamToModel 的 getMainProcess()==null）
                排除项：
                  * org/activiti/image/impl/**  内嵌的第三方流程图渲染器（AWT 绘图代码，非本仓库业务逻辑）
                  * DuskWorkflowApplication      Spring Boot 启动类（脚手架）
                  * **WorkflowMapperImpl         MapStruct 生成的实现类
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco-maven-plugin.version}</version>
                <configuration>
                    <excludes>
                        <exclude>org/activiti/image/impl/**</exclude>
                        <exclude>com/dusk/module/workflow/DuskWorkflowApplication.class</exclude>
                        <exclude>**/WorkflowMapperImpl.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check-branch-coverage</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.98</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <distributionManagement>
        <repository>
            <id>github-dusk-module-workflow</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-workflow</url>
        </repository>
    </distributionManagement>
</project>
