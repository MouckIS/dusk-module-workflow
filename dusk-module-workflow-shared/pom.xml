<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dusk</groupId>
        <artifactId>dusk-module-shared-parent</artifactId>
        <version>1.2.0</version>
        <relativePath/>
    </parent>
    <artifactId>dusk-module-workflow-shared</artifactId>
    <name>dusk-module-workflow-shared</name>
    <dependencies>
        <dependency>
            <groupId>com.dusk</groupId>
            <artifactId>dusk-common-mqs</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JDK 23+ 起 javac 不再从 classpath 隐式发现注解处理器，
                仅把 lombok 放进 <dependencies> 不会生效，必须显式声明 annotationProcessorPaths，
                否则 lombok 生成的成员（如 @FieldNameConstants 的 Fields）报「找不到符号」。
                与 dusk-module-metadata-shared 保持一致。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.48</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-dusk-module-shared-parent</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-shared-parent</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>github-dusk-common</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-common</url>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
    <distributionManagement>
        <repository>
            <id>github-dusk-module-workflow</id>
            <url>https://maven.pkg.github.com/mouckis/dusk-module-workflow</url>
        </repository>
    </distributionManagement>
</project>
